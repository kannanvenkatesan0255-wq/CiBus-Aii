# ==============================================================================
# CIBUS-AI Root Environment Configuration Template
# File: .env.example
# ==============================================================================

# Backend Server Configuration (Render automatically sets PORT)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Backend CORS Configuration
FRONTEND_URL=https://cibus-ai-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Client Configuration
VITE_API_BASE_URL=https://cibus-ai-backend.onrender.com
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
