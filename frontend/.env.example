# ==============================================================================
# CIBUS-AI Frontend Environment Configuration Template
# File: frontend/.env.example
# ==============================================================================

# FastAPI Backend Base URL (Render Web Service URL, e.g. https://cibus-ai-backend.onrender.com)
VITE_API_BASE_URL=https://cibus-ai-backend.onrender.com

# Mapbox GL Public Access Token (optional, enables interactive live Mapbox tile view)
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
