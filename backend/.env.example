# ==============================================================================
# CIBUS-AI Backend Environment Configuration Template
# File: backend/.env.example
# ==============================================================================

# Server Network Configuration (Render automatically injects PORT)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Frontend URL for CORS (e.g., Render Static Site URL)
FRONTEND_URL=https://cibus-ai-frontend.onrender.com

# Additional CORS origins (comma-separated, optional)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
